# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers).
# Include a database name, e.g. .../kosherradar?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Allowed browser origin (the Vite dev server). Only this origin may call the API.
CLIENT_URL=http://localhost:5173

# First admin account, used only by `npm run seed:admin`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Later milestones (not used yet): Cloudinary, Geoapify, Resend
