# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers).
# Include a database name, e.g. .../kosherradar?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Allowed browser origin (the Vite dev server). Only this origin may call the API.
CLIENT_URL=http://localhost:5173

# First admin account, used only by `npm run seed:admin`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (free tier) for certificate photos. Cloudinary dashboard -> Settings -> API Keys.
# Server-only: never put these in the frontend. Without them, photo upload answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (free tier) for rejection emails and password reset. https://resend.com/api-keys
# EMAIL_FROM must be a sender on a domain you verified in Resend, e.g. KosherRadar <noreply@your-domain.com>.
# Without a verified domain Resend only lets you send from onboarding@resend.dev to your OWN account email.
# Without both values no email is sent: moderation decisions are still saved and the admin sees "not sent".
RESEND_API_KEY=
EMAIL_FROM=

# Later milestones (not used yet): Geoapify
