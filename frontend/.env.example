# Copy this file to .env. Vite only exposes variables that start with VITE_ to the browser,
# so never put secrets here.

# Base URL of the Express API (must match backend PORT, and the backend CLIENT_URL must be this app's origin)
VITE_API_URL=http://localhost:5000/api

# Public Geoapify browser key for map tiles (required for the map background).
# Create a SEPARATE key restricted to allowed website origins, including localhost for development.
# Vite embeds this value in the browser bundle; do not reuse backend GEOAPIFY_API_KEY or any secret.
# Restart Vite after changing this value; production builds must be rebuilt.
VITE_GEOAPIFY_MAPS_API_KEY=
